{
  "name": "globacart-gh-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/sync-database.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:backfill": "prisma db execute --schema prisma/schema.prisma --file prisma/backfill.sql",
    "db:seed": "prisma db execute --schema prisma/schema.prisma --file prisma/seed.sql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cloudinary": "^2.10.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.14.0",
    "next": "^16.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prisma": "^6.8.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "deepmerge-ts": "^8.0.0"
  }
}
