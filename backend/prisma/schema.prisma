generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MOBILE_MONEY
  PAYSTACK
}

enum PaymentStatus {
  PAY_ON_DELIVERY
  PENDING
  PAID
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model Product {
  id            Int            @id
  name          String
  description   String
  price         Float
  originalPrice Float?
  imagePath     String
  galleryImages String         @default("[]")
  category      String
  tags          String         @default("[]")
  rating        Float          @default(4.5)
  reviewCount   Int            @default(0)
  inStock       Boolean        @default(true)
  sizes         String         @default("[]")
  colors        String         @default("[]")
  isNew         Boolean        @default(false)
  isBestSeller  Boolean        @default(false)
  // Products that already appear in orders are archived instead of deleted so
  // order history keeps its references.
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([isArchived, category])
}

// One row per Firebase user, created lazily on first authenticated request.
model Customer {
  uid                    String         @id
  email                  String
  name                   String?
  phone                  String?
  preferredPaymentMethod PaymentMethod  @default(CASH_ON_DELIVERY)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  addresses              Address[]
  wishlistItems          WishlistItem[]

  @@index([email])
}

model Address {
  id            String   @id @default(cuid())
  customerUid   String
  label         String
  recipientName String
  phone         String
  street        String
  city          String
  region        String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerUid], references: [uid], onDelete: Cascade)

  @@index([customerUid])
}

model WishlistItem {
  customerUid String
  productId   Int
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerUid], references: [uid], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerUid, productId])
}

model Order {
  id                      String          @id @default(cuid())
  // Upper-cased last 10 characters of the id; what customers type to track.
  trackingCode            String?         @unique
  // Null only for orders placed before accounts were linked by uid.
  customerUid             String?
  customerName            String
  customerEmail           String?
  customerPhone           String
  deliveryAddress         String?
  notes                   String?
  paymentMethod           PaymentMethod   @default(CASH_ON_DELIVERY)
  paymentStatus           PaymentStatus   @default(PAY_ON_DELIVERY)
  paymentReference        String?
  paymentAuthorizationUrl String?
  paidAt                  DateTime?
  // Client-generated key that makes checkout retries return the same order.
  clientRequestId         String?         @unique
  subtotal                Float
  shippingFee             Float
  total                   Float
  status                  OrderStatus     @default(PENDING)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  items                   OrderItem[]
  events                  OrderEvent[]
  returnRequests          ReturnRequest[]

  @@index([customerUid, createdAt])
  @@index([customerEmail])
  @@index([paymentReference])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     Int
  productName   String
  unitPrice     Float
  quantity      Int
  selectedColor String?
  selectedSize  String?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

// Status timeline shown on tracking pages.
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  customerUid String
  reason      String
  details     String?
  status      ReturnStatus @default(REQUESTED)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([customerUid, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}
