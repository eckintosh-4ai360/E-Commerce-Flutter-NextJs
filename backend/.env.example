# --- Database --------------------------------------------------------------
# On Neon, keep connect_timeout/pool_timeout: a sleeping database can take a few
# seconds to wake, and the defaults (5s / 10s) make the first requests fail.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30"
# Recommended for schema synchronization. The build falls back to DATABASE_URL
# when this is unset, which is useful for providers that expose one connection.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"

# --- Public URL (strongly recommended in production) ------------------------
# Used for absolute image URLs in the API, links in emails, the sitemap and
# social previews. Without it, image paths are returned relative to the API host.
PUBLIC_APP_URL="http://localhost:3000"

# --- Admin access (required to use /admin) ----------------------------------
# Comma-separated Google accounts allowed to manage products, orders and returns.
ADMIN_EMAILS="you@example.com"

# --- Firebase (sign-in) ------------------------------------------------------
# Verifying Google sign-in only needs the project id. The service account is
# optional and only needed for other Firebase Admin features.
FIREBASE_ADMIN_PROJECT_ID="commerce-80c74"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Web sign-in config for the storefront. Defaults match lib/firebase_options.dart;
# override only if you use a different Firebase project. These are public values.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Email (optional) --------------------------------------------------------
# Order confirmations, status updates and return updates. Skipped when unset.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="GlobaCart GH <onboarding@resend.dev>"

# --- Paystack test payments -------------------------------------------------
# Test keys only. The server rejects live keys while this integration is in
# test mode. Configure the webhook URL as /api/payments/paystack/webhook.
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"
# Optional override; defaults to PUBLIC_APP_URL + /api/payments/paystack/callback.
PAYSTACK_CALLBACK_URL="http://localhost:3000/api/payments/paystack/callback"
# Set this URL in the Paystack dashboard; it documents the configured endpoint.
PAYSTACK_WEBHOOK_URL="http://localhost:3000/api/payments/paystack/webhook"

# --- Image uploads in the admin (optional) -----------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Mobile app download links shown on the website (optional) ---------------
# When unset, the site shows "Coming soon" badges and hides the app banner.
NEXT_PUBLIC_ANDROID_APP_URL=""
NEXT_PUBLIC_IOS_APP_URL=""

# --- CORS (optional) -----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser (for example a
# separately hosted Flutter web build). Unset = any origin. Mobile apps are not
# affected by CORS.
# CORS_ALLOWED_ORIGINS="https://app.example.com"
