DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional but recommended for absolute URLs in API responses and emails
PUBLIC_APP_URL="http://localhost:3000"

# Required for Google-authenticated checkout in the Flutter app
FIREBASE_ADMIN_PROJECT_ID="commerce-80c74"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@commerce-80c74.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Transactional email delivery for order status updates
RESEND_API_KEY="outline"
ORDER_EMAIL_FROM="Eckintosh Mall <onboarding@resend.dev>"
